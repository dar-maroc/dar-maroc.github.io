      "icons": [{ "src": "images/icon-192.png", "sizes": "192x192" }]
    }
  ],
  "screenshots": [
    {
      "src": "images/banner-with-logo.png",
      "sizes": "1717x916",
      "type": "image/png",
      "form_factor": "wide",
      "label": "DarMaroc — immobilier & services au Maroc"
    }
  ],
  "share_target": {
    "action": "deposer-annonce.html",
    "method": "GET",
    "enctype": "application/x-www-form-urlencoded",
